---
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).map((post) => ({
  type: "文章",
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  href: `/posts/${post.id}/`,
  text: `${post.data.title} ${post.data.description} ${post.data.category} ${post.data.tags.join(" ")} ${post.body ?? ""}`,
}));

const diaries = (await getCollection("diary", ({ data }) => !data.draft)).map((entry) => ({
  type: "日记",
  title: entry.data.title,
  description: entry.body?.replace(/\s+/g, " ").trim().slice(0, 96) ?? "",
  tags: entry.data.tags,
  href: `/diary/#diary-${entry.id}`,
  text: `${entry.data.title} ${entry.data.tags.join(" ")} ${entry.body ?? ""}`,
}));

const searchPayload = JSON.stringify([...posts, ...diaries]).replace(/</g, "\\u003c");
---

<search class="site-search" role="search">
  <label class="sr-only" for="global-search-input">搜索文章和日记</label>
  <div class="search-input-wrap">
    <img class="search-icon" src="/assets/search-icon.png" alt="" width="18" height="18" aria-hidden="true" />
    <input id="global-search-input" type="search" placeholder="搜索文章 / 日记" autocomplete="off" data-search-input />
  </div>
  <div class="search-results" data-search-results hidden></div>
  <script type="application/json" data-search-index set:html={searchPayload}></script>
</search>
