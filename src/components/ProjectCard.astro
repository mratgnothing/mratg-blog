---
import TagLink from "./TagLink.astro";
import { projectHref, type Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isFeatured = project.className.includes("featured");
const href = projectHref(project);
const optimizedImageBase = project.image.match(/^\/assets\/project-[\w-]+\.jpg$/)
  ? project.image.replace(/\.jpg$/, "")
  : "";
const imageSizes = "(max-width: 920px) calc(100vw - 64px), (max-width: 1180px) calc((100vw - 72px) / 2), 520px";
---

<article id={`project-${project.slug}`} class:list={["project-card", project.className]} data-reveal>
  <a class="card-media card-media-link" href={href} aria-label={`查看 ${project.title} 项目详情`}>
    {
      optimizedImageBase ? (
        <picture>
          <source
            type="image/avif"
            srcset={`${optimizedImageBase}-640.avif 640w, ${optimizedImageBase}-960.avif 960w, ${optimizedImageBase}-1280.avif 1280w`}
            sizes={imageSizes}
          />
          <source
            type="image/webp"
            srcset={`${optimizedImageBase}-640.webp 640w, ${optimizedImageBase}-960.webp 960w, ${optimizedImageBase}-1280.webp 1280w`}
            sizes={imageSizes}
          />
          <img src={project.image} alt={project.alt} loading="lazy" decoding="async" sizes={imageSizes} />
        </picture>
      ) : (
        <img src={project.image} alt={project.alt} loading="lazy" decoding="async" />
      )
    }
  </a>
  <div class="card-top">
    <span class:list={["pixel-icon", project.icon]}></span>
    <p>{project.label}</p>
  </div>
  <h3><a href={href}>{project.title}</a></h3>
  <p>{project.description}</p>
  <ul class="tag-list">
    {project.tags.map((tag) => <li><TagLink tag={tag} /></li>)}
  </ul>
  <div class="card-actions">
    {
      project.links.map((link) =>
        link.href ? (
          <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
        ) : (
          <span>{link.label}</span>
        )
      )
    }
  </div>
  {isFeatured && <img class="card-empty-decor card-empty-decor-turtle" src="/assets/decor-turtle.png" alt="" loading="lazy" decoding="async" aria-hidden="true" />}
</article>
