---
import GlobalSearch from "./GlobalSearch.astro";

const navItems = [
  ["Projects", "/#projects"],
  ["Research", "/#research"],
  ["Writing", "/#writing"],
  ["Journal", "/#journal"],
  ["Diary", "/#diary"],
  ["Games", "/#games"],
  ["Contact", "/#contact"],
];
---

<header class="site-header">
  <a class="brand" href="/#top" aria-label="Mr.ATG home">
    <picture class="brand-picture">
      <source type="image/webp" srcset="/assets/avatar-96.webp" />
      <img class="brand-mark" src="/assets/avatar.png" alt="Mr.ATG avatar" width="38" height="38" fetchpriority="high" />
    </picture>
    <span>
      <strong>Mr.ATG</strong>
      <small>Pixel Lab</small>
    </span>
  </a>
  <GlobalSearch />
  <nav class="nav" aria-label="Primary navigation">
    {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
</header>
