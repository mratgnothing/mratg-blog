---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---

<BaseLayout title="高校风云 · 线上规则测试">
  <SiteHeader />
  <main class="gxf-page">
    <section class="gxf-hero">
      <div>
        <p class="gxf-kicker">高校风云 / GAOXIAO FENGYUN</p>
        <h1>中国高校战略博弈<br /><span>1990 → 2050</span></h1>
        <p>v0.5 线上规则测试台。完整加载 336 张卡牌数据，并提供单机三人局的第一版回合模拟。</p>
      </div>
      <div class="gxf-stamp" aria-label="prototype"><strong>规则测试</strong><span>PROTOTYPE · 0.1</span></div>
    </section>

    <section class="gxf-manifest" aria-label="卡牌系统">
      <button class="manifest-chip active" data-filter="all">全部 <b id="count-all">336</b></button>
      <button class="manifest-chip school" data-filter="school">高校 <b id="count-school">48</b></button>
      <button class="manifest-chip faculty" data-filter="faculty">院系 <b id="count-faculty">96</b></button>
      <button class="manifest-chip talent" data-filter="talent">人才 <b id="count-talent">36</b></button>
      <button class="manifest-chip event" data-filter="event">事件 <b id="count-event">72</b></button>
      <button class="manifest-chip project" data-filter="project">国家工程 <b id="count-project">60</b></button>
      <button class="manifest-chip policy" data-filter="policy">政策 <b id="count-policy">24</b></button>
    </section>

    <section class="gxf-board" id="game-board">
      <header class="board-topline">
        <div><span>时代</span><strong id="era-label">1990s</strong></div>
        <div><span>阶段</span><strong id="phase-label">准备</strong></div>
        <div><span>行动点</span><strong id="ap-label">4 AP</strong></div>
        <button id="new-game" class="gxf-button primary">开始新模拟</button>
      </header>

      <div class="board-grid">
        <aside class="board-side">
          <div class="panel-title"><span>校务委员会</span><b>YOUR UNIVERSITY</b></div>
          <label class="school-picker">选择高校<select id="school-select"></select></label>
          <article class="school-card card-shell" id="player-school-card">
            <div class="card-top"><span class="card-type">高校牌</span><span class="tier-badge" id="school-tier">领跑档</span></div>
            <div class="school-identity">
              <div class="crest" id="school-crest"><span>校</span></div>
              <div><h2 id="school-name">清华大学</h2><p id="school-meta">一线 · 核心：传统工科 / 新工科</p></div>
            </div>
            <div class="school-skill"><strong id="school-skill-title">自强不息</strong><p id="school-skill-text">加载牌库中…</p></div>
          </article>
          <div class="resource-grid">
            <div><span>💰 经费</span><b id="money">6</b></div>
            <div><span>🔬 科研</span><b id="science">2</b></div>
            <div><span>🎓 生源</span><b id="students">4</b></div>
            <div><span>🏛 政策</span><b id="policy">2</b></div>
            <div class="wide"><span>⭐ 声望</span><b id="prestige">12</b></div>
          </div>
          <div class="action-stack">
            <button data-action="research">科研攻关 <small>1 AP · +2🔬</small></button>
            <button data-action="admissions">招生宣传 <small>1 AP · 2💰 → +2🎓</small></button>
            <button data-action="thinktank">智库通道 <small>1 AP · 2🏛 → +1⭐</small></button>
            <button data-action="end" class="end-era">结束本时代</button>
          </div>
        </aside>

        <div class="board-center">
          <section class="era-track" id="era-track"></section>
          <section class="event-zone">
            <div class="zone-label"><span>时代事件</span><small>ERA EVENTS</small></div>
            <div class="event-cards" id="event-cards"><div class="empty-state">开始模拟后翻开时代事件</div></div>
          </section>
          <section class="project-zone">
            <div class="zone-label"><span>国家重大工程</span><small>NATIONAL PROJECTS</small></div>
            <div class="project-cards" id="project-cards"></div>
          </section>
          <section class="campus-zone">
            <div class="zone-label"><span>你的院系</span><small>CAMPUS</small></div>
            <div class="campus-grid" id="campus-grid"></div>
          </section>
          <section class="log-zone">
            <div class="zone-label"><span>校史记录</span><small>GAME LOG</small></div>
            <ol id="game-log"><li>牌库加载中…</li></ol>
          </section>
        </div>

        <aside class="market-side">
          <section>
            <div class="panel-title"><span>院系市场</span><b>FACULTY</b></div>
            <div class="market-list" id="faculty-market"></div>
          </section>
          <section>
            <div class="panel-title"><span>人才市场</span><b>TALENT</b></div>
            <div class="market-list" id="talent-market"></div>
          </section>
          <section>
            <div class="panel-title"><span>政策市场</span><b>POLICY</b></div>
            <div class="market-list" id="policy-market"></div>
          </section>
        </aside>
      </div>
    </section>

    <section class="gxf-catalogue">
      <div class="catalogue-heading">
        <div><p class="gxf-kicker">CARD ARCHIVE</p><h2>完整卡牌档案</h2></div>
        <label>搜索卡牌<input id="card-search" type="search" placeholder="学校 / AI / 航天 / 政策…" /></label>
      </div>
      <div class="catalogue-grid" id="catalogue-grid"></div>
    </section>

    <section class="design-notes">
      <p class="gxf-kicker">VISUAL SYSTEM</p>
      <h2>统一设计语言：国家档案 × 教育蓝图 × 科技工程</h2>
      <div class="design-grid">
        <article><b>高校牌 · 朱砂 / 象牙</b><p>校徽徽章位、核心门类色带、校史纸张纹理与招牌能力章。</p></article>
        <article><b>政策牌 · 紫绀 / 金印</b><p>公文档案、批注、印章与执行时机标签，强调制度工具感。</p></article>
        <article><b>国家工程 · 靛蓝 / 青图</b><p>工程蓝图、坐标网格、项目编号、门类协同与声望池。</p></article>
        <article><b>时代事件 · 报刊 / 信号色</b><p>年代戳、新闻标题结构，利好绿、利空红、规则蓝。</p></article>
        <article><b>院系牌 · 学科谱系</b><p>八门类各自辅色，等级、方向、成本、产出形成固定阅读顺序。</p></article>
        <article><b>人才牌 · 学术肖像</b><p>人物肖像主视觉，讲席、杰青/长江、院士三个稀有度框架。</p></article>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script is:inline>
(() => {
  const BASE='/assets/games/gaoxiao-fengyun/data/';
  const files={school:'高校风云-50校全案.md',faculty:'高校风云-院系牌全库.md',talent:'高校风云-人才牌全库.md',event:'高校风云-事件牌全库.md',project:'高校风云-国家重大工程牌全库.md',policy:'高校风云-政策牌全库.md'};
  const eras=['1990s','2000s','2010s','2020s','2030s','2040s'];
  const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const clean=s=>String(s??'').replace(/\*\*/g,'').replace(/`/g,'').trim();
  const shuffle=a=>[...a].sort(()=>Math.random()-.5);
  const state={cards:[],decks:{},era:0,ap:4,started:false,players:[],me:null,markets:{faculty:[],talent:[],policy:[]},events:[],projects:[]};

  function parseSchools(t){
    const cards=[]; let tier='';
    for(const raw of t.split(/\r?\n/)){
      if(raw.startsWith('## 第二部分')) tier='领跑档';
      if(raw.startsWith('## 第三部分')) tier='劲旅档';
      if(raw.startsWith('## 第四部分')) tier='蓄力档';
      const m=raw.match(/^\*\*([^*]+)\*\*\s*\|\s*([^|]+)\|\s*核心:([^|]+)\|\s*开局:(.+)$/);
      if(!m) continue;
      cards.push({type:'school',id:'S'+String(cards.length+1).padStart(2,'0'),name:m[1],tier,region:m[2].trim(),core:m[3].trim(),start:m[4].trim(),body:''});
    }
    for(const c of cards){
      const idx=t.indexOf(`**${c.name}**`); const next=t.indexOf('\n**',idx+4); const chunk=t.slice(idx,next>idx?next:idx+900);
      const sm=chunk.match(/【([^】]+)】([^\n]+)/); if(sm){c.skill=sm[1];c.body=clean(sm[2]);}
    }
    return cards;
  }
  function tableRows(t,re){const out=[]; for(const line of t.split(/\r?\n/)){if(!line.startsWith('|'))continue;const p=line.split('|').slice(1,-1).map(x=>x.trim());if(re.test(p[0]||''))out.push(p);}return out;}
  function parseFaculties(t){return tableRows(t,/^(?:W|F|SCI|AGR|MED|BUS|ENG|NEW)\d{2}$/).map(p=>({type:'faculty',id:p[0],name:p[1],level:p[2],tags:p[3],body:`${p[2]} · ${p[3]}`}));}
  function parseTalents(t){
    const rows=tableRows(t,/^[LY]\d{2}$/).map(p=>({type:'talent',id:p[0],name:p[1],discipline:p[2],tags:p[3],body:p.slice(4).join(' · ')}));
    for(const m of t.matchAll(/^###\s+(A\d{2})\s+(.+)$/gm)){const start=m.index,end=t.indexOf('\n---',start);const chunk=t.slice(start,end>0?end:start+700);rows.push({type:'talent',id:m[1],name:m[2],discipline:(chunk.match(/门类：([^｜\n]+)/)||[])[1]||'',tags:(chunk.match(/方向：([^｜\n]+)/)||[])[1]||'',body:clean(chunk.split('\n').slice(1).join(' ')).slice(0,220)});}return rows;
  }
  function parseEvents(t){const out=[];for(const line of t.split(/\r?\n/)){const m=line.match(/^\s*(\d+)\.\s*(🟢|🔴|🔵)\*\*「(.+?)」\*\*\|\s*([^|]+)\|\s*(.+)$/u);if(m)out.push({type:'event',id:'E'+m[1].padStart(2,'0'),tone:m[2],name:m[3],range:m[4].trim(),duration:clean(m[5]),body:''});else if(out.length&&/^\s{2,}\S/.test(line))out[out.length-1].body+=' '+clean(line);}return out;}
  function parseProjects(t){const out=[];for(const m of t.matchAll(/^###\s+(P\d{2})\s+(.+)$/gm)){const start=m.index,end=t.indexOf('\n### ',start+4);const chunk=t.slice(start,end>0?end:start+900);out.push({type:'project',id:m[1],name:m[2],body:clean(chunk.split('\n').slice(1).join(' ')).slice(0,330)});}return out;}
  function parsePolicies(t){const out=[];for(const m of t.matchAll(/^###\s+([GTRD]\d{2})\s+(.+)$/gm)){const start=m.index,end=t.indexOf('\n---',start);const chunk=t.slice(start,end>0?end:start+700);out.push({type:'policy',id:m[1],name:m[2],body:clean(chunk.split('\n').slice(1).join(' ')).slice(0,280)});}return out;}

  async function load(){
    const raw={}; await Promise.all(Object.entries(files).map(async([k,f])=>raw[k]=await fetch(BASE+encodeURIComponent(f)).then(r=>r.text())));
    state.decks.school=parseSchools(raw.school); state.decks.faculty=parseFaculties(raw.faculty); state.decks.talent=parseTalents(raw.talent); state.decks.event=parseEvents(raw.event); state.decks.project=parseProjects(raw.project); state.decks.policy=parsePolicies(raw.policy);
    state.cards=Object.values(state.decks).flat();
    for(const k of Object.keys(files)){document.getElementById('count-'+k).textContent=state.decks[k].length;}
    document.getElementById('count-all').textContent=state.cards.length;
    setupPicker(); renderCatalogue(); renderEraTrack(); log(`牌库装载完成：${state.cards.length}/336 张。`);
  }

  function setupPicker(){const el=document.getElementById('school-select');el.innerHTML=state.decks.school.map((s,i)=>`<option value="${i}">${esc(s.name)} · ${esc(s.tier)}</option>`).join('');el.addEventListener('change',()=>showSchool(state.decks.school[+el.value]));showSchool(state.decks.school[0]);}
  function initials(name){return name.replace(/大学|学院|中国|北京|上海|南京|香港/g,'').slice(0,2)||name.slice(0,2)}
  function showSchool(s){if(!s)return;document.getElementById('school-name').textContent=s.name;document.getElementById('school-tier').textContent=s.tier;document.getElementById('school-meta').textContent=`${s.region} · 核心：${s.core}`;document.getElementById('school-skill-title').textContent=s.skill||'办学特色';document.getElementById('school-skill-text').textContent=s.body||s.start;document.getElementById('school-crest').innerHTML=`<span>${esc(initials(s.name))}</span>`;}

  function cardHTML(c,compact=false){const icon={school:'校',faculty:'系',talent:'人',event:c.tone||'事',project:'国',policy:'策'}[c.type];const meta=c.type==='school'?`${c.tier} · ${c.region}`:c.type==='faculty'?`${c.id} · ${c.level} · ${c.tags}`:c.type==='talent'?`${c.id} · ${c.discipline} · ${c.tags}`:c.id;return `<article class="archive-card ${c.type}${compact?' compact':''}" data-kind="${c.type}" data-search="${esc((c.name+' '+meta+' '+c.body).toLowerCase())}"><header><span>${esc(icon)}</span><small>${esc(meta)}</small></header><h3>${esc(c.name)}</h3>${compact?'':`<p>${esc(c.body||c.core||'')}</p>`}</article>`;}
  function renderCatalogue(){const q=(document.getElementById('card-search').value||'').toLowerCase();const active=document.querySelector('.manifest-chip.active')?.dataset.filter||'all';const list=state.cards.filter(c=>(active==='all'||c.type===active)&&(!q||(c.name+' '+c.body+' '+c.tags+' '+c.core).toLowerCase().includes(q)));document.getElementById('catalogue-grid').innerHTML=list.slice(0,336).map(c=>cardHTML(c)).join('')||'<div class="empty-state">没有匹配卡牌</div>';}
  document.querySelectorAll('.manifest-chip').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.manifest-chip').forEach(x=>x.classList.remove('active'));b.classList.add('active');renderCatalogue();document.querySelector('.gxf-catalogue').scrollIntoView({behavior:'smooth'});}));
  document.getElementById('card-search').addEventListener('input',renderCatalogue);

  function initPlayer(s,human=false){const res=s.tier==='领跑档'?{prestige:12,money:6}:{prestige:s.tier==='蓄力档'?2:6,money:s.tier==='蓄力档'?4:5};const core=s.core.split(/[、/]/).map(x=>x.trim());return {school:s,human,prestige:res.prestige,money:res.money,science:2,students:4,policy:2,campus:core.slice(0,s.tier==='领跑档'?3:2).map((d,i)=>({name:d+'院系',discipline:d,level:i===0?2:1,strength:i===0?4:2})),projects:{}};}
  function startGame(){const choice=state.decks.school[+document.getElementById('school-select').value||0];const rivals=shuffle(state.decks.school.filter(s=>s!==choice)).slice(0,2);state.players=[initPlayer(choice,true),...rivals.map(s=>initPlayer(s))];state.me=state.players[0];state.era=0;state.started=true;startEra(true);log(`新模拟开始：${choice.name} vs ${rivals.map(x=>x.name).join(' / ')}`);}
  function startEra(first=false){state.ap=4;state.me.money+=state.me.school.region.includes('港澳')?5:3;state.me.policy+=1;const ev=state.decks.event.slice(state.era*12,state.era*12+12);state.events=shuffle(ev).slice(0,state.era===0?1:2);const pr=state.decks.project.filter(p=>+p.id.slice(1)>state.era*10&&+p.id.slice(1)<=state.era*10+10);state.projects=shuffle(pr).slice(0,4);state.markets.faculty=shuffle(state.decks.faculty.filter(f=>!f.id.startsWith('NEW')||state.era>=2)).slice(0,6);state.markets.talent=shuffle(state.decks.talent).slice(0,3);state.markets.policy=shuffle(state.decks.policy).slice(0,4);renderAll();if(!first)log(`进入 ${eras[state.era]}：预算到账，翻开 ${state.events.length} 张事件与 4 项国家工程。`);}
  function renderEraTrack(){document.getElementById('era-track').innerHTML=eras.map((e,i)=>`<div class="era-node ${i===state.era?'current':''} ${i<state.era?'done':''}"><span>${i+1}</span><b>${e}</b></div>`).join('');}
  function renderAll(){renderEraTrack();document.getElementById('era-label').textContent=eras[state.era];document.getElementById('phase-label').textContent='行动阶段';document.getElementById('ap-label').textContent=state.ap+' AP';for(const k of ['money','science','students','policy','prestige'])document.getElementById(k).textContent=state.me[k];showSchool(state.me.school);document.getElementById('event-cards').innerHTML=state.events.map(cardHTML).join('');document.getElementById('project-cards').innerHTML=state.projects.map(p=>`<div class="project-wrap">${cardHTML(p,true)}<button data-bid="${p.id}">申报 · 1🔬 / 1 AP <b>${state.me.projects[p.id]||0}点</b></button></div>`).join('');document.getElementById('campus-grid').innerHTML=state.me.campus.map((f,i)=>`<article class="campus-card"><span>院系 ${i+1}</span><h3>${esc(f.name)}</h3><p>${esc(f.discipline)} · 等级 ${'ⅠⅡⅢ'[f.level-1]} · 强度 ${f.strength}</p></article>`).join('');renderMarkets();document.querySelectorAll('[data-bid]').forEach(b=>b.onclick=()=>bid(b.dataset.bid));}
  function renderMarkets(){document.getElementById('faculty-market').innerHTML=state.markets.faculty.map((c,i)=>`${cardHTML(c,true)}<button data-buy-fac="${i}">建设</button>`).join('');document.getElementById('talent-market').innerHTML=state.markets.talent.map((c,i)=>`${cardHTML(c,true)}<button data-buy-tal="${i}">招募</button>`).join('');document.getElementById('policy-market').innerHTML=state.markets.policy.map((c,i)=>`${cardHTML(c,true)}<button data-buy-pol="${i}">购买</button>`).join('');document.querySelectorAll('[data-buy-fac]').forEach(b=>b.onclick=()=>buyFaculty(+b.dataset.buyFac));document.querySelectorAll('[data-buy-tal]').forEach(b=>b.onclick=()=>buyTalent(+b.dataset.buyTal));document.querySelectorAll('[data-buy-pol]').forEach(b=>b.onclick=()=>buyPolicy(+b.dataset.buyPol));}
  function spendAP(){if(!state.started)return false;if(state.ap<=0){log('本时代 AP 已用尽。');return false;}state.ap--;return true;}
  function action(kind){if(kind==='end')return endEra();if(!spendAP())return;if(kind==='research'){state.me.science+=2;log('科研攻关：+2🔬。');}if(kind==='admissions'){if(state.me.money<2){state.ap++;return log('经费不足，无法招生宣传。');}state.me.money-=2;state.me.students+=2;log('招生宣传：2💰 → +2🎓。');}if(kind==='thinktank'){if(state.me.policy<2){state.ap++;return log('政策力不足，无法使用智库通道。');}state.me.policy-=2;state.me.prestige+=1;log('智库通道：2🏛 → +1⭐。');}renderAll();}
  document.querySelectorAll('[data-action]').forEach(b=>b.onclick=()=>action(b.dataset.action));
  function facultyCost(c){const lv=c.level==='Ⅱ'?2:1;const high=/^(SCI|MED|ENG)/.test(c.id),newg=c.id.startsWith('NEW');return lv===2?(newg?8:high?7:6):(newg?4:high?3:2);}
  function disciplineFromId(id){if(id.startsWith('W'))return'文';if(id.startsWith('F'))return'法';if(id.startsWith('SCI'))return'理';if(id.startsWith('AGR'))return'农';if(id.startsWith('MED'))return'医';if(id.startsWith('BUS'))return'商';if(id.startsWith('ENG'))return'传统工科';return'新工科';}
  function buyFaculty(i){const c=state.markets.faculty[i],cost=facultyCost(c);if(!spendAP())return;if(state.me.money<cost){state.ap++;return log(`建设 ${c.name} 需要 ${cost}💰。`);}if(state.me.campus.length>=6){state.ap++;return log('已达到基础院系上限 6。');}state.me.money-=cost;const level=c.level==='Ⅱ'?2:1;state.me.campus.push({name:c.name,discipline:disciplineFromId(c.id),level,strength:level===2?4:2});state.markets.faculty.splice(i,1,...shuffle(state.decks.faculty).slice(0,1));log(`建设 ${c.name}，支付 ${cost}💰。`);renderAll();}
  function talentCost(c){return c.id.startsWith('A')?7:c.id.startsWith('Y')?4:2;}
  function buyTalent(i){const c=state.markets.talent[i],cost=talentCost(c);if(!spendAP())return;if(state.me.money<cost){state.ap++;return log(`招募 ${c.name} 至少需要 ${cost} 资源。`);}state.me.money-=cost;state.me.prestige+=c.id.startsWith('A')?2:0;if(state.me.campus[0])state.me.campus[0].strength+=c.id.startsWith('A')?3:c.id.startsWith('Y')?2:0;state.markets.talent.splice(i,1,...shuffle(state.decks.talent).slice(0,1));log(`招募 ${c.name}。`);renderAll();}
  function policyCost(c){return +(c.body.match(/费用：(\d+)/)||[])[1]||2;}
  function buyPolicy(i){const c=state.markets.policy[i],cost=policyCost(c);if(!spendAP())return;if(state.me.policy<cost){state.ap++;return log(`购买 ${c.name} 需要 ${cost}🏛。`);}state.me.policy-=cost;state.markets.policy.splice(i,1,...shuffle(state.decks.policy).slice(0,1));log(`购入政策「${c.name}」。测试版将其记入政策使用记录。`);renderAll();}
  function bid(id){if(!spendAP())return;if(state.me.science<1){state.ap++;return log('至少需要 1🔬 才能申报工程。');}state.me.science--;state.me.projects[id]=(state.me.projects[id]||0)+1;log(`向 ${id} 追加 1🔬，当前 ${state.me.projects[id]} 有效基础点。`);renderAll();}
  function aiTurn(p){p.money+=3;for(let n=0;n<4;n++){const r=Math.random();if(r<.35)p.science+=2;else if(r<.55&&p.money>=2){p.money-=2;p.students+=2;}else if(r<.78){p.campus.push({name:'扩建院系',discipline:shuffle(['文','法','理','农','医','商','传统工科','新工科']).find(x=>state.era>=2||x!=='新工科'),level:1,strength:2});p.money=Math.max(0,p.money-2);}else p.prestige+=1;}}
  function evaluate(){const cats=['文','法','理','农','医','商','传统工科','新工科'];for(const cat of cats){const rank=state.players.map(p=>({p,s:p.campus.filter(f=>f.discipline===cat).reduce((a,f)=>a+f.strength,0)})).filter(x=>x.s>0).sort((a,b)=>b.s-a.s);if(rank[0])rank[0].p.prestige+=['理','医','传统工科','新工科'].includes(cat)?5:4;if(rank[1])rank[1].p.prestige+=['理','医','传统工科','新工科'].includes(cat)?3:2;}log(`${eras[state.era]} 学科评估完成，按重点档 5/3⭐、常规档 4/2⭐结算。`);}
  function settleProjects(){for(const pr of state.projects){const mine=state.me.projects[pr.id]||0;if(mine){const ai=Math.floor(Math.random()*3);if(mine>=ai){state.me.prestige+=2;log(`${pr.id} ${pr.name}：本校进入项目头部，测试结算 +2⭐。`);}}}}
  function endEra(){if(!state.started)return;state.players.slice(1).forEach(aiTurn);settleProjects();if([1,3,5].includes(state.era))evaluate();if(state.era>=5){const rank=[...state.players].sort((a,b)=>b.prestige-a.prestige);log(`2050 终局：${rank.map((p,i)=>`${i+1}.${p.school.name} ${p.prestige}⭐`).join(' / ')}`);document.getElementById('phase-label').textContent='终局';state.ap=0;renderAll();return;}state.era++;startEra();}
  function log(msg){const el=document.getElementById('game-log');if(!el)return;const li=document.createElement('li');li.textContent=msg;el.prepend(li);while(el.children.length>14)el.lastChild.remove();}
  document.getElementById('new-game').onclick=startGame;
  load().catch(e=>{console.error(e);log('牌库加载失败：'+e.message);});
})();
</script>

