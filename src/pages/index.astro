---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import CommentBox from "../components/CommentBox.astro";
import EngagementBar from "../components/EngagementBar.astro";
import TagLink from "../components/TagLink.astro";
import { journalTopics, projects, researchItems } from "../data/projects";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf()
);
const recentPosts = posts.slice(0, 6);
const columns = (await getCollection("columns", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const writingColumns = columns.filter((column) => column.data.group === "writing");
const journalColumns = columns.filter((column) => column.data.group === "journal");
const journalColumnByTitle = new Map(journalColumns.map((column) => [column.data.title, column]));
const diaryEntries = (await getCollection("diary", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.datetime.valueOf() - a.data.datetime.valueOf()
);
const diaryItems = await Promise.all(
  diaryEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
const recentDiaryItems = diaryItems.slice(0, 3);
const diaryDecorImages = ["/assets/decor-cat.png", "/assets/decor-fox.png", "/assets/decor-villager.png"];
const postDateFormatter = new Intl.DateTimeFormat("zh-CN", {
  month: "2-digit",
  day: "2-digit",
  timeZone: "Asia/Shanghai",
});
const diaryDateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
  timeZone: "Asia/Shanghai",
});
const formatPostDate = (date: Date) => postDateFormatter.format(date);
const formatDiaryDate = (date: Date) => diaryDateFormatter.format(date);
const publicTopicLinks = [
  { label: "SDD-YOLO experiments", href: "/projects/sdd-yolo/" },
  { label: "WAVE-cloud progress", href: "/projects/wave-cloud/" },
  { label: "arXiv notes", href: "/posts/arxiv-first-submission/" },
  { label: "AI Agent logs", href: "/tags/agent/" },
  { label: "PhyX platform", href: "/projects/seuphyx/" },
  { label: "Fitness routine", href: "/posts/pull-up-16-half-semester/" },
  { label: "Daily gaming", href: "/columns/games/" },
  { label: "高校风云 · 线上测试", href: "/games/gaoxiao-fengyun/" },
  { label: "Recent Music", href: "/columns/music/" },
];
---

<BaseLayout>
  <SiteHeader />

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-art" aria-hidden="true">
        <picture>
          <source
            type="image/avif"
            srcset="/assets/pixel-lab-hero-960.avif 960w, /assets/pixel-lab-hero-1536.avif 1536w"
            sizes="100vw"
          />
          <source
            type="image/webp"
            srcset="/assets/pixel-lab-hero-960.webp 960w, /assets/pixel-lab-hero-1536.webp 1536w"
            sizes="100vw"
          />
          <img src="/assets/pixel-lab-hero.jpg" alt="" fetchpriority="high" decoding="async" />
        </picture>
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-content" data-reveal>
        <p class="eyebrow">Chien-Shiung Wu College, Southeast University / INFJ / Builder</p>
        <h1 id="hero-title" class="hero-title">
          <span class="hero-title-main">Computer vision,</span>
          <span class="hero-title-script">crafted pixel by pixel.</span>
        </h1>
        <p class="hero-copy">
          我是 ATG，东南大学吴健雄学院本科生，关注小目标检测、边缘 AI 与 AI 工程化系统。这里也记录游戏、音乐、旅行和那些让我保持好奇的事情。
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">View Projects</a>
          <a class="button ghost" href="#writing">Read Notes</a>
        </div>
        <ul class="quick-stats" aria-label="Focus areas">
          <li><span>CV</span><strong>Small Object Detection</strong></li>
          <li><span>Edge</span><strong>Ascend 310 / RK3588</strong></li>
          <li><span>Life</span><strong>Games / Music / Travel</strong></li>
        </ul>
      </div>
    </section>

    <section class="section intro-band" data-reveal>
      <div>
        <p class="section-kicker">Now Public</p>
        <h2>这里会</h2>
        <h2>公开记录什么</h2>
      </div>
      <div class="ticker" aria-label="Public topics">
        {publicTopicLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </section>

    <section class="section village-motion-band" aria-label="Pixel village route">
      <div class="village-panorama" aria-hidden="true">
        <picture>
          <source
            type="image/avif"
            srcset="/assets/village-lab-panorama-768.avif 768w, /assets/village-lab-panorama-1120.avif 1120w, /assets/village-lab-panorama-1400.avif 1400w"
            sizes="(max-width: 920px) calc(100vw - 32px), 1120px"
          />
          <source
            type="image/webp"
            srcset="/assets/village-lab-panorama-768.webp 768w, /assets/village-lab-panorama-1120.webp 1120w, /assets/village-lab-panorama-1400.webp 1400w"
            sizes="(max-width: 920px) calc(100vw - 32px), 1120px"
          />
          <img src="/assets/village-lab-panorama.png" alt="" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="village-motion-copy">
        <p class="section-kicker">Pixel Route</p>
        <h2>路漫漫</h2>
        <h2>其修远兮</h2>
        <p>每个人皆是西西弗斯，要在本质荒谬的生活中活出花样来。</p>
      </div>
    </section>

    <section id="projects" class="section" aria-labelledby="projects-title">
      <div class="section-heading" data-reveal>
        <p class="section-kicker">Projects</p>
        <h2 id="projects-title">代表项目</h2>
        <p>I don't need SEX❤ beacuse SEU❤ fucks me evryday.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="research" class="section research-lab" aria-labelledby="research-title">
      <div class="research-cover" data-reveal>
        <img src="/assets/research-archive-pixel.png" alt="Pixel art computer vision research archive with drone detection screen." loading="lazy" decoding="async" />
        <div class="research-stamp">
          <span>Open Archive</span>
          <strong>Paper / Dataset / Deploy</strong>
        </div>
      </div>
      <div class="research-copy">
        <div class="section-heading sticky-heading" data-reveal>
          <p class="section-kicker">Research</p>
          <h2 id="research-title">研究与公开材料</h2>
          <p>项目相关论文、数据集说明、模型结构图、实验记录和部署报告。</p>
        </div>
        <div class="timeline">
          {
            researchItems.map((item) => (
              <article class="timeline-item" data-reveal>
                <span>{item.number}</span>
                <h3>{item.title}</h3>
                <p>
                  {item.href ? <a href={item.href} target="_blank" rel="noreferrer">{item.body}</a> : item.body}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="writing" class="section" aria-labelledby="writing-title">
      <div class="writing-lab" data-reveal>
        <div class="writing-cover">
          <img src="/assets/writing-desk-pixel.png" alt="Pixel art technical writing desk with article planning cards." loading="lazy" decoding="async" />
        </div>
        <div class="writing-copy">
          <span>Field Notes</span>
          <strong>把实验、部署和踩坑记录成可复用的文章。</strong>
          <p>电灯熄灭 物换星移 泥牛入海</p>
          <p>黑暗好像 一颗巨石 按在胸口</p>
        </div>
      </div>
      <div class="section-heading section-heading-row" data-reveal>
        <div>
          <p class="section-kicker">Writing</p>
          <h2 id="writing-title">最近更新的文章</h2>
          <p>当你觉得自己不行了就出去转转，这样你就变成了行人。</p>
        </div>
        <a class="text-action" href="/posts/">查看全部文章</a>
      </div>
      <div class="writing-board">
        <aside class="column-shelf" aria-label="Writing columns" data-reveal>
          <img src="/assets/content-studio-pixel.png" alt="Pixel art local content studio with markdown cards and checklist." loading="lazy" />
          <div class="column-list">
            {
              writingColumns.map((column) => (
                <a class:list={["column-card", `accent-${column.data.accent}`]} href={`/columns/${column.id}/`}>
                  <span>{column.data.title}</span>
                  <p>{column.data.description}</p>
                  <em>Open column</em>
                </a>
              ))
            }
          </div>
        </aside>
        <div class="post-grid">
          {
            recentPosts.map((post) => <PostCard post={post} dateLabel={formatPostDate(post.data.updated ?? post.data.date)} />)
          }
        </div>
      </div>
    </section>

    <section id="journal" class="section journal" aria-labelledby="journal-title">
      <div class="journal-cover" data-reveal>
        <img src="/assets/journal-life.jpg" alt="Pixel art desk with games music travel and campus life objects." loading="lazy" decoding="async" />
      </div>
      <div class="section-heading" data-reveal>
        <p class="section-kicker">Journal</p>
        <h2 id="journal-title">不只写代码</h2>
        <p>网站会保留更轻松的内容入口：游戏、音乐、旅行、校园生活和个人观察。技术项目负责展示能力，生活日志负责保留温度。</p>
      </div>
      <div class="journal-shelf" data-reveal>
        {
          journalTopics.map((topic) => (
            <a class="shelf-item" href={`/columns/${journalColumnByTitle.get(topic.title)?.id ?? "horizon"}/`}>
              <span class:list={["shelf-pixel", topic.icon]}></span>
              <strong>{topic.title}</strong>
              <p>{topic.body}</p>
              <em>Open column</em>
            </a>
          ))
        }
      </div>
    </section>

    <section id="diary" class="section diary-section" aria-labelledby="diary-title">
      <div class="section-heading section-heading-row" data-reveal>
        <div>
          <p class="section-kicker">Diary</p>
          <h2 id="diary-title">日记时间线</h2>
          <p>话说张雪峰老师算不算卖课而结课殉。</p>
        </div>
        <a class="text-action" href="/diary/">查看全部日记</a>
      </div>
      <div class="diary-timeline" data-reveal>
        {
          recentDiaryItems.map(({ entry, Content }, index) => (
            <article class="diary-entry" id={`diary-${entry.id}`}>
              <img class="diary-empty-decor" src={diaryDecorImages[index % diaryDecorImages.length]} alt="" loading="lazy" decoding="async" aria-hidden="true" />
              <time datetime={entry.data.datetime.toISOString()}>{formatDiaryDate(entry.data.datetime)}</time>
              <div>
                <h3>{entry.data.title}</h3>
                <Content />
                {entry.data.tags.length > 0 && (
                  <ul class="diary-tags">
                    {entry.data.tags.map((tag) => <li><TagLink tag={tag} /></li>)}
                  </ul>
                )}
                <div class="diary-actions">
                  <EngagementBar
                    threadId={`diary:${entry.id}`}
                    title={entry.data.title}
                    description={entry.body?.replace(/\s+/g, " ").trim().slice(0, 96) ?? ""}
                    href={`/diary/#diary-${entry.id}`}
                    type="日记"
                    dateLabel={formatDiaryDate(entry.data.datetime)}
                  />
                  <CommentBox threadId={`diary:${entry.id}`} compact collapsed />
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="contact" class="section contact-panel" aria-labelledby="contact-title" data-reveal>
      <div>
        <p class="section-kicker">Contact</p>
        <h2 id="contact-title">一起交流项目、游戏和车兵生活</h2>
        <p>如果你对War Thunder/MC/文明VI/星露谷/地平线、小目标检测/AI Agent/昇腾部署、弦乐/电音/纯音乐 感兴趣，可以从这里找到我。</p>
      </div>
      <img class="contact-empty-decor" src="/assets/decor-villager.png" alt="" loading="lazy" decoding="async" aria-hidden="true" />
      <div class="contact-links">
        <a href="https://github.com/mratgnothing" target="_blank" rel="noreferrer">GitHub / mratgnothing</a>
        <a href="https://x.com/A_T_G114514" target="_blank" rel="noreferrer">X / A_T_G114514</a>
        <a href="https://music.163.com/#/user/home?id=12148050703" target="_blank" rel="noreferrer">NetEase Cloud Music / Mr.ATG</a>
        <a href="mailto:213240443@seu.edu.cn">213240443@seu.edu.cn</a>
      </div>
      <div class="friend-links" aria-label="Friends and collaborators">
        <span>Collaborator</span>
        <a href="https://vedaru.cn/" target="_blank" rel="noreferrer">
          <strong>Vedaru</strong>
          <small>EdgeDistillDet / WAVE partner</small>
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
