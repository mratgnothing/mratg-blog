---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostCard from "../../components/PostCard.astro";
import TagLink from "../../components/TagLink.astro";
import { projectHref, projects } from "../../data/projects";
import { tagHref, tagSlug } from "../../lib/tags";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const diaryEntries = await getCollection("diary", ({ data }) => !data.draft);
  const tagMap = new Map<string, string>();
  const addTags = (tags: string[]) => {
    tags.forEach((tag) => {
      const slug = tagSlug(tag);
      if (!tagMap.has(slug)) {
        tagMap.set(slug, tag);
      }
    });
  };

  posts.forEach((post) => addTags(post.data.tags));
  diaryEntries.forEach((entry) => addTags(entry.data.tags));
  projects.forEach((project) => addTags(project.tags));

  return Array.from(tagMap, ([slug, label]) => ({
    params: { tag: slug },
    props: { label },
  }));
}

interface Props {
  label: string;
}

const { label } = Astro.props;
const currentSlug = Astro.params.tag ?? tagSlug(label);
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf()
);
const diaryEntries = (await getCollection("diary", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.datetime.valueOf() - a.data.datetime.valueOf()
);
const taggedPosts = posts.filter((post) => post.data.tags.some((tag) => tagSlug(tag) === currentSlug));
const taggedProjects = projects.filter((project) => project.tags.some((tag) => tagSlug(tag) === currentSlug));
const taggedDiary = diaryEntries.filter((entry) => entry.data.tags.some((tag) => tagSlug(tag) === currentSlug));
const totalCount = taggedPosts.length + taggedProjects.length + taggedDiary.length;
const tagStats = Array.from(
  [
    ...posts.flatMap((post) => post.data.tags.map((tag) => ({ tag, type: "post" }))),
    ...projects.flatMap((project) => project.tags.map((tag) => ({ tag, type: "project" }))),
    ...diaryEntries.flatMap((entry) => entry.data.tags.map((tag) => ({ tag, type: "diary" }))),
  ].reduce((stats, item) => {
    const slug = tagSlug(item.tag);
    const current = stats.get(slug) ?? { tag: item.tag, posts: 0, projects: 0, diary: 0, total: 0 };
    if (item.type === "post") current.posts += 1;
    if (item.type === "project") current.projects += 1;
    if (item.type === "diary") current.diary += 1;
    current.total += 1;
    stats.set(slug, current);
    return stats;
  }, new Map<string, { tag: string; posts: number; projects: number; diary: number; total: number }>())
).sort((a, b) => b[1].posts - a[1].posts || b[1].total - a[1].total || a[1].tag.localeCompare(b[1].tag, "zh-CN"));
const featuredTags = tagStats.slice(0, 14).map(([, stat]) => stat);
const tagPlacements = [
  { x: 34, y: 28, w: 270, tilt: -5, spriteX: "0%", spriteY: "0%" },
  { x: 51, y: 27, w: 286, tilt: 3, spriteX: "33.333%", spriteY: "0%" },
  { x: 67, y: 29, w: 284, tilt: 4, spriteX: "100%", spriteY: "0%" },
  { x: 36, y: 40, w: 286, tilt: 2, spriteX: "0%", spriteY: "100%" },
  { x: 53, y: 39, w: 290, tilt: -4, spriteX: "33.333%", spriteY: "100%" },
  { x: 68, y: 42, w: 260, tilt: -2, spriteX: "100%", spriteY: "100%" },
  { x: 34, y: 52, w: 260, tilt: 4, spriteX: "66.666%", spriteY: "0%" },
  { x: 51, y: 51, w: 278, tilt: -3, spriteX: "0%", spriteY: "0%" },
  { x: 67, y: 54, w: 276, tilt: 5, spriteX: "66.666%", spriteY: "100%" },
  { x: 36, y: 64, w: 278, tilt: -3, spriteX: "33.333%", spriteY: "0%" },
  { x: 53, y: 63, w: 286, tilt: 2, spriteX: "33.333%", spriteY: "100%" },
  { x: 67, y: 66, w: 290, tilt: -5, spriteX: "0%", spriteY: "100%" },
  { x: 42, y: 74, w: 276, tilt: -2, spriteX: "33.333%", spriteY: "100%" },
  { x: 61, y: 74, w: 250, tilt: 4, spriteX: "100%", spriteY: "0%" },
] as const;
const tagPlacementStyle = (index: number) => {
  const placement = tagPlacements[index % tagPlacements.length];
  return `--tag-x: ${placement.x}%; --tag-y: ${placement.y}%; --tag-w: ${placement.w}px; --tag-tilt: ${placement.tilt}deg; --tag-sprite-x: ${placement.spriteX}; --tag-sprite-y: ${placement.spriteY};`;
};

const postDateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "Asia/Shanghai",
});
const diaryDateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
  timeZone: "Asia/Shanghai",
});
const formatPostDate = (date: Date) => postDateFormatter.format(date);
const formatDiaryDate = (date: Date) => diaryDateFormatter.format(date);
const excerpt = (body: string | undefined) => body?.replace(/\s+/g, " ").trim().slice(0, 120) ?? "";
---

<BaseLayout title={`标签：${label} | Mr.ATG`} description={`查看 Mr.ATG Pixel Lab 中所有带有 ${label} 标签的文章、项目和日记。`}>
  <SiteHeader />

  <main class="archive-page tag-page">
    <section class="archive-hero tag-hero" data-reveal>
      <a href="/#writing">Back Home</a>
      <p class="section-kicker">Tag Archive</p>
      <h1>#{label}</h1>
      <p>这里汇总所有带有这个标签的文章、项目和日记。当前共有 {totalCount} 条内容。</p>
    </section>

    <section class="archive-posts" aria-labelledby="tag-results-title">
      <div class="section-heading" data-reveal>
        <p class="section-kicker">Tagged Items</p>
        <h2 id="tag-results-title">相关内容</h2>
      </div>
      {totalCount > 0 ? (
        <div class="post-grid archive-post-grid tag-result-grid">
          {taggedPosts.map((post) => <PostCard post={post} dateLabel={formatPostDate(post.data.updated ?? post.data.date)} />)}

          {taggedProjects.map((project) => (
            <article class="post-card tag-result-card" data-reveal>
              <span>项目</span>
              <h3><a href={projectHref(project)}>{project.title}</a></h3>
              <p>{project.description}</p>
              <ul class="tag-list post-tags">
                {project.tags.map((tag) => <li><TagLink tag={tag} /></li>)}
              </ul>
              <time>Project</time>
            </article>
          ))}

          {taggedDiary.map((entry) => (
            <article class="post-card tag-result-card" data-reveal>
              <span>日记</span>
              <h3><a href={`/diary/#diary-${entry.id}`}>{entry.data.title}</a></h3>
              <p>{excerpt(entry.body)}</p>
              <ul class="tag-list post-tags">
                {entry.data.tags.map((tag) => <li><TagLink tag={tag} /></li>)}
              </ul>
              <time datetime={entry.data.datetime.toISOString()}>{formatDiaryDate(entry.data.datetime)}</time>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state" data-reveal>
          <strong>这个标签暂时没有公开内容。</strong>
          <p>可以从下面的标签索引切换到其他标签。</p>
        </div>
      )}
    </section>

    <section class="archive-posts tag-index" aria-labelledby="tag-index-title">
      <div class="section-heading" data-reveal>
        <p class="section-kicker">Featured Tags</p>
        <h2 id="tag-index-title">标签索引</h2>
        <p>点击即可跳转。可以在顶部搜索栏搜索想寻找的标签。</p>
      </div>
      <ul class="tag-list tag-cloud" data-reveal>
        {featuredTags.map((item, index) => (
          <li style={tagPlacementStyle(index)}>
            <a class="tag-button tag-notice-link" href={tagHref(item.tag)}>
              <span class="tag-label">{item.tag}</span>
              <span class="tag-count">{item.total} 条</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
