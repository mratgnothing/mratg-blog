---
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
}

const {
  title = "Mr.ATG | Pixel Lab",
  description = "Mr.ATG 的像素风个人博客，记录计算机视觉、边缘 AI、AI 工程化平台、游戏、音乐与旅行。",
  article = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/avatar.png" />
    <!-- 预加载关键字体以减少布局偏移和 FCP 时间 -->
    <link rel="preload" href="/fonts/IdeaFonts-XiangSuZhiCheng.woff2" as="font" type="font/woff2" crossorigin />
    <!-- 优化 LCP 图片预加载：使用 fetchpriority="high" 提升优先级 -->
    <link rel="preload" as="image" href="/assets/pixel-lab-hero.jpg" fetchpriority="high" />
  </head>
  <body class:list={[article && "article-page"]}>
    <div class="cursor-glow" aria-hidden="true"></div>
    <canvas class="starfield" aria-hidden="true"></canvas>
    <slot />
    <!-- 使用 defer 异步加载脚本，避免阻塞主线程渲染 -->
    <script is:inline defer src="/script.js"></script>
  </body>
</html>
